const seo = seoBySlug[post.slug] || {
  title: post.title,
  description: post.excerpt,
  products: [],
  articles: [],
};

const displayTitle = seo.title;
const displayDescription = seo.description;
---
<Layout title={displayTitle} description={displayDescription} article={{ publishedTime: post.date }}>
  <main class="blog-page" style="max-width: 720px; margin: 0 auto; padding: 3rem 1.5rem;">
    <button id="theme-toggle" class="theme-toggle-btn">🌙 Dark</button>

    <nav aria-label="Breadcrumb" style="margin-bottom: 1rem;">
      <a href="/">Beranda</a> <span aria-hidden="true">›</span>
      <a href="/blog/">Blog</a> <span aria-hidden="true">›</span>
      <span>{displayTitle}</span>
    </nav>

    <a href="/blog/">← Kembali ke Blog</a>
    <h1 style="margin-top: 1rem;">{displayTitle}</h1>
    <p class="post-date"><em>{new Date(post.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</em></p>
    {post.image && <img src={post.image} alt={displayTitle} style="width:100%; border-radius: 8px; margin: 1.5rem 0;" loading="eager" decoding="async" />}
    {post.content.map((block) => {
      if (block.type === 'h2') {
        const heading = seo.h2?.[block.text] || block.text;
        return <h2 style="margin-top: 2rem; margin-bottom: 0.75rem;">{heading}</h2>;
      }
      if (block.type === 'h3') return <h3 style="margin-top: 1.5rem; margin-bottom: 0.5rem;">{block.text}</h3>;
      if (block.type === 'image') return <img src={block.src} alt={block.alt || displayTitle} style="width:100%; border-radius: 8px; margin: 1.5rem 0;" loading="lazy" decoding="async" />;
      if (block.type === 'list') {
        const Tag = block.style === 'ordered' ? 'ol' : 'ul';
        return <Tag style="margin: 0 0 1rem 1.25rem; line-height: 1.7;">
          {block.items.map((item) => <li style="margin-bottom: 0.4rem;" set:html={item} />)}
        </Tag>;
      }
      if (block.type === 'table') {
        return <table style="width:100%; border-collapse: collapse; margin:1.5rem 0; background:#fff; color:#222;">
          <thead>
            <tr>{block.headers.map((h) => <th style="text-align:left; padding:.6rem; border-bottom:2px solid #ccc; background:#f5f0e8; color:#222;">{h}</th>)}</tr>
          </thead>
          <tbody>
            {block.rows.map((row) => (
              <tr>{row.map((cell) => <td style="padding:.6rem; border-bottom:1px solid #e5e5e5; background:#fff; color:#222;" set:html={cell} />)}</tr>
            ))}
          </tbody>
        </table>;
      }
      return <p style="line-height:1.7; margin-bottom:1rem;" set:html={block.text} />;
    })}

    {(seo.products.length > 0 || seo.articles.length > 0) && (
      <aside class="article-links" aria-label="Konten terkait">
        {seo.products.length > 0 && (
          <section>
            <h2>Produk Terkait</h2>
            <ul>
              {seo.products.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            </ul>
          </section>
        )}
        {seo.articles.length > 0 && (
          <section>
            <h2>Baca Juga</h2>
            <ul>
              {seo.articles.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            </ul>
          </section>
        )}
      </aside>
    )}
  </main>
</Layout>

<style>
  .article-links {
    margin-top: 3rem;
    padding: 1.5rem;
    border-radius: 12px;
    background: rgba(245, 240, 232, 0.7);
  }

  .article-links section + section {
    margin-top: 1.5rem;
  }

  .article-links h2 {
    margin: 0 0 0.6rem;
    font-size: 1.25rem;
  }

  .article-links ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  .article-links li {
    margin-bottom: 0.4rem;
  }
</style>

<script>
  const btn = document.getElementById('theme-toggle');
  const root = document.documentElement;

  function applyTheme(theme) {
    if (theme === 'dark') {
      root.setAttribute('data-theme', 'dark');
      btn.textContent = '☀️ Light';
    } else {
      root.removeAttribute('data-theme');
      btn.textContent = '🌙 Dark';
    }
  }

  const saved = localStorage.getItem('blog-theme') || 'light';
  applyTheme(saved);

  btn.addEventListener('click', () => {
    const isDark = root.getAttribute('data-theme') === 'dark';
    const next = isDark ? 'light' : 'dark';
    localStorage.setItem('blog-theme', next);
    applyTheme(next);
  });
</script>

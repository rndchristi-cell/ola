      'Filosofi Surjan Lurik': 'Filosofi dan Makna Surjan Lurik',
      'Inspirasi Padu Padan Surjan Lurik': 'Inspirasi Padu Padan Surjan Lurik',
      'Tips Memilih Surjan Lurik': 'Tips Memilih Surjan Lurik',
      'Cara Merawat Surjan Lurik': 'Cara Merawat Surjan Lurik',
      'Surjan Lurik dan Pelestarian Produk Lokal': 'Surjan Lurik dan Produk Lokal',
      'Penutup': 'Kesimpulan',
    },

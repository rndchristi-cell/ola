---
import Layout from '../../../layouts/Layout.astro';
import blogData from '../../../data/blog.en.json';

export async function getStaticPaths() {
  return blogData.posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const description = post.excerpt || `${post.title}. Read the Ola Store guide to Solo lurik, Javanese attire, and traditional handwoven fabric.`;
const cleanHtml = (value: string) => value.replace(/\\([*_])/g, '$1');
---
<Layout lang="en" title={post.title} description={description} image={post.image} type="article" publishedTime={post.date} modifiedTime={post.date}>
  <main class="blog-page" style="max-width: 720px; margin: 0 auto; padding: 3rem 1.5rem;">
    <button id="theme-toggle" class="theme-toggle-btn" type="button">🌙 Dark</button>
    <nav aria-label="Breadcrumb" class="breadcrumbs">
      <a href="/en/">Home</a><span aria-hidden="true">/</span><a href="/en/blog/">Blog</a><span aria-hidden="true">/</span><span>{post.title}</span>
    </nav>
    <a href="/en/blog/">← Back to Blog</a>
    <article>
      <header>
        <h1 style="margin-top: 1rem;">{post.title}</h1>
        <p class="post-date"><time datetime={post.date}><em>{new Date(post.date).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })}</em></time></p>
      </header>
      {post.image && <img src={post.image} alt={post.title} width="1200" height="800" style="width:100%; height:auto; border-radius: 8px; margin: 1.5rem 0;" />}
      <div class="article-content">
        {post.content.map((block) => {
          if (block.type === 'paragraph' && block.text.trim() === '---') return null;
          if (block.type === 'h2') return <h2 style="margin-top: 2rem; margin-bottom: 0.75rem;">{cleanHtml(block.text)}</h2>;
          if (block.type === 'h3') return <h3 style="margin-top: 1.5rem; margin-bottom: 0.5rem;">{cleanHtml(block.text)}</h3>;
          if (block.type === 'image') return <img src={block.src} alt={block.alt || post.title} loading="lazy" width="1200" height="800" style="width:100%; height:auto; border-radius: 8px; margin: 1.5rem 0;" />;
          if (block.type === 'list') {
            const Tag = block.style === 'ordered' ? 'ol' : 'ul';
            return <Tag style="margin: 0 0 1rem 1.25rem; line-height: 1.7;">{block.items.map((item) => <li style="margin-bottom: 0.4rem;" set:html={cleanHtml(item)} />)}</Tag>;
          }
          if (block.type === 'table') {
            return <div style="overflow-x:auto;"><table style="width:100%; border-collapse: collapse; margin: 1.5rem 0; background: #fff; color: #222;"><thead><tr>{block.headers.map((h) => <th scope="col" style="text-align:left; padding:0.6rem; border-bottom:2px solid #ccc; background:#f5f0e8; color:#222;">{cleanHtml(h)}</th>)}</tr></thead><tbody>{block.rows.map((row) => <tr>{row.map((cell) => <td style="padding:0.6rem; border-bottom:1px solid #e5e5e5; background:#fff; color:#222;" set:html={cleanHtml(cell)} />)}</tr>)}</tbody></table></div>;
          }
          return <p style="line-height: 1.7; margin-bottom: 1rem;" set:html={cleanHtml(block.text)} />;
        })}
      </div>
    </article>
    <aside class="article-cta" aria-label="Contact Ola Store">
      <h2>Discover Lurik and Javanese Attire at Ola Store</h2>
      <p>Browse our catalog or visit our store at Pasar Klewer Solo.</p>
      <p><a href="/en/#produk">View catalog</a> · <a href="/en/#lokasi">View store location</a></p>
    </aside>
  </main>
</Layout>
<script>
  const btn = document.getElementById('theme-toggle');
  const root = document.documentElement;
  function applyTheme(theme) {
    if (theme === 'dark') { root.setAttribute('data-theme', 'dark'); if (btn) btn.textContent = '☀️ Light'; }
    else { root.removeAttribute('data-theme'); if (btn) btn.textContent = '🌙 Dark'; }
  }
  const saved = localStorage.getItem('blog-theme') || 'light';
  applyTheme(saved);
  btn?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    localStorage.setItem('blog-theme', next);
    applyTheme(next);
  });
</script>
<style>
  .breadcrumbs { display:flex; flex-wrap:wrap; gap:.45rem; margin:1rem 0; font-size:.9rem; color:#6b6257; }
  .breadcrumbs span:last-child { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:100%; }
  .article-cta { margin-top:3rem; padding:1.5rem; border-radius:12px; background:#f5f0e8; }
</style>

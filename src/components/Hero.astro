---
import site from '../data/site.json';
import { getTranslations, type Language } from '../data/i18n';
const { lang = 'id' } = Astro.props as { lang?: Language };
const t = getTranslations(lang);
---

<section class="hero" id="home">
  <div class="hero-inner">
    <div class="hero-content">
      <div class="hero-badge">
        <span>🏛️</span> {site.location}
      </div>
      <h1>{t.hero.title}<br><span>{t.hero.highlight}</span></h1>
      <p>{t.hero.description}</p>
      <div class="hero-buttons">
        <a href="#produk" class="btn-primary">{t.hero.catalog}</a>
        <a href={`https://wa.me/${site.waNumber}`} class="btn-secondary" target="_blank">💬 {t.hero.chat}</a>
      </div>
    </div>
    <div class="hero-image">
      <div class="hero-img-frame">
        <!-- GANTI FOTO: taruh gambar di public/images/hero.webp -->
        <img src="/images/hero.webp" alt="Koleksi Lurik Ola Store" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
        <div class="hero-img-placeholder" style="display:none;">
          <span class="icon">👘</span>
          <span>Taruh foto di<br>public/images/hero.webp</span>
        </div>
      </div>
      <div class="floating-tag tag-1">⭐ {site.rating} Rating</div>
      <div class="floating-tag tag-2">✅ {site.reviews} {t.stats.reviews}</div>
    </div>
  </div>
</section>

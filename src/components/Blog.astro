---
import idBlogData from '../data/blog.json';
import enBlogData from '../data/blog.en.json';
import { getTranslations, type Language } from '../data/i18n';
const { lang = 'id' } = Astro.props as { lang?: Language };
const t = getTranslations(lang);
const blogData = lang === 'en' ? enBlogData : idBlogData;

const posts = [...blogData.posts].sort(
  (a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf()
);
const featuredPosts = posts.slice(0, 4);
---

<section id="blog" class="blog-section">
  <div class="container">
    <h2>{t.blog.title}</h2>
    <div class="blog-grid">
      {featuredPosts.map((post) => (
        <article class="blog-card">
          {post.image && <img src={post.image} alt={post.title} loading="lazy" />}
          <div class="blog-card-body">
            <h3>{post.title}</h3>
            <p>{post.excerpt}</p>
            <a href={`/${lang}/blog/${post.slug}/`}>{t.blog.readMore}</a>
          </div>
        </article>
      ))}
    </div>
    {posts.length > featuredPosts.length && (
      <div class="blog-more">
        <a href={`/${lang}/blog/`}>{t.blog.all}</a>
      </div>
    )}
  </div>
</section>

<style>
  .blog-section {
    padding: 4rem 1rem;
  }
  .blog-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
  margin-top: 2rem;
}

@media (min-width: 768px) {
  .blog-grid {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }
}
  .blog-card {
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    overflow: hidden;
  }
  .blog-card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
  }
  .blog-card-body {
    padding: 1rem;
  }
  .blog-card-body a {
    display: inline-block;
    margin-top: 0.5rem;
    font-weight: 600;
    text-decoration: none;
  }
  .blog-more { text-align: center; margin-top: 2rem; }
  .blog-more a { font-weight: 600; text-decoration: none; }
</style>

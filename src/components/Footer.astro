---
import site from '../data/site.json';
---

<footer class="footer" id="kontak">
  <div class="footer-inner">
    <div class="footer-brand">
      <h3 class="footer-brand-heading">
        <img src="/images/logo.webp" alt="" width="64" height="64" />
        <span>{site.siteName}</span>
      </h3>
      <p>Toko lurik & busana Jawa asli dari Pasar Klewer Solo. Melestarikan warisan budaya melalui fashion berkualitas.</p>
    </div>
    <div class="footer-col">
      <h4>Menu</h4>
      <a href="#home">Beranda</a>
      <a href="#produk">Katalog</a>
      <a href="#tentang">Tentang</a>
      <a href="#lokasi">Lokasi</a>
    </div>
    <div class="footer-col">
      <h4>Sosial Media</h4>
      <a class="footer-link" href={`https://instagram.com/${site.instagram.replace('@','')}`} target="_blank" rel="noopener noreferrer">
        <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
        <span>Instagram {site.instagram}</span>
      </a>
      <a class="footer-link" href={`https://facebook.com/${site.facebook}`} target="_blank" rel="noopener noreferrer">
        <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-8h2.75l.42-3h-3.17V8.1c0-.87.24-1.46 1.5-1.46h1.8V3.96c-.31-.04-1.38-.14-2.62-.14-2.59 0-4.36 1.58-4.36 4.48V10H7v3h2.82v8h3.68Z"/></svg>
        <span>Facebook</span>
      </a>
      <a class="footer-link" href={`https://x.com/${site.twitter}`} target="_blank" rel="noopener noreferrer">
        <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.9 2H22l-6.77 7.74L23.2 22h-6.25l-4.9-6.41L6.45 22H3.33l7.24-8.28L2.8 2h6.4l4.43 5.86L18.9 2Zm-1.1 17.8h1.73L8.27 4.08H6.4L17.8 19.8Z"/></svg>
        <span>X / Twitter</span>
      </a>
    </div>
    <div class="footer-col">
      <h4>Kontak</h4>
      <a class="footer-link" href={`https://wa.me/${site.waNumber}`} target="_blank" rel="noopener noreferrer">
        <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M20 11.5a8 8 0 0 1-11.8 7.1L4 20l1.4-4.1A8 8 0 1 1 20 11.5Z"/><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M9 8.5c.2 2 2.4 4.2 4.5 4.5l1.2-1.2c.2-.2.5-.3.8-.1l1.4.7c.3.1.4.4.3.7-.3 1.1-1.3 1.7-2.4 1.5-3.8-.7-6.8-3.7-7.5-7.5-.2-1.1.4-2.1 1.5-2.4.3-.1.6 0 .7.3l.7 1.4c.1.3.1.6-.1.8L9 8.5Z"/></svg>
        <span>WhatsApp</span>
      </a>
      <a class="footer-link" href={`mailto:${site.email}`}>
        <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path fill="none" stroke="currentColor" stroke-width="2" d="m4 7 8 6 8-6"/></svg>
        <span>Email</span>
      </a>
      <a class="footer-link" href={site.googleMapsUrl} target="_blank" rel="noopener noreferrer">
        <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5" fill="none" stroke="currentColor" stroke-width="2"/></svg>
        <span>Google Maps</span>
      </a>
    </div>
  </div>
  <div class="footer-bottom">
    © {new Date().getFullYear()} {site.siteName} — {site.location}. Dibuat dengan ❤️ di Solo.
  </div>
</footer>
<style>
  .footer-brand-heading { display:flex; align-items:center; gap:.7rem; }
  .footer-brand-heading img { width:54px; height:54px; border-radius:10px; object-fit:cover; background:#fff; }
  .footer-link { display:flex !important; align-items:center; gap:.55rem; }
  .footer-icon { width:1.15rem; height:1.15rem; flex:0 0 1.15rem; }
  @media (max-width: 767px) {
    .footer-brand-heading { justify-content:center; }
    .footer-link { justify-content:center; }
  }
</style>

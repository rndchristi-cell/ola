---
import site from '../data/site.json';
import { getTranslations, type Language } from '../data/i18n';
import CookieConsent from './CookieConsent.astro';
const { lang = 'id' } = Astro.props as { lang?: Language };
const t = getTranslations(lang);
const isLocalizedPage = /^\/(id|en)\//.test(Astro.url.pathname);
const homePath = isLocalizedPage ? `/${lang}/` : '/';
---

<footer class="footer" id="kontak">
  <div class="footer-inner">
    <div class="footer-brand">
      <h3 class="footer-brand-heading">
        <img src="/images/logo.webp" alt="" width="64" height="64" />
        <span>{site.siteName}</span>
      </h3>
      <p>{t.footer.description}</p>
    </div>
    <div class="footer-col">
      <h4>{t.footer.menu}</h4>
      <a href={`${homePath}#home`}>{t.nav.home}</a>
      <a href={`${homePath}#produk`}>{t.nav.catalog}</a>
      <a href={`${homePath}#tentang`}>{t.nav.about}</a>
      <a href={`${homePath}#lokasi`}>{t.nav.location}</a>
      {lang === 'en' && <a href="/en/shipping/">How to Order</a>}
    </div>
    <div class="footer-col footer-social-col">
      <h4>{t.footer.social}</h4>
      <div class="social-icons" aria-label={lang === 'en' ? 'Social media links' : 'Tautan media sosial'}>
        <a class="social-icon-link" href={`https://instagram.com/${site.instagram.replace('@','')}`} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
        </a>
        <a class="social-icon-link" href={`https://facebook.com/${site.facebook}`} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-8h2.75l.42-3h-3.17V8.1c0-.87.24-1.46 1.5-1.46h1.8V3.96c-.31-.04-1.38-.14-2.62-.14-2.59 0-4.36 1.58-4.36 4.48V10H7v3h2.82v8h3.68Z"/></svg>
        </a>
        <a class="social-icon-link" href={`https://x.com/${site.twitter}`} target="_blank" rel="noopener noreferrer" aria-label="X / Twitter">
          <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.9 2H22l-6.77 7.74L23.2 22h-6.25l-4.9-6.41L6.45 22H3.33l7.24-8.28L2.8 2h6.4l4.43 5.86L18.9 2Zm-1.1 17.8h1.73L8.27 4.08H6.4L17.8 19.8Z"/></svg>
        </a>
        <a class="social-icon-link" href="https://www.pinterest.com/olalurik" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
          <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.5a9.5 9.5 0 0 0-3.47 18.34c-.08-1.56-.01-3.44.39-4.93l1.06-4.5s-.27-.55-.27-1.36c0-1.27.74-2.22 1.67-2.22.79 0 1.17.59 1.17 1.29 0 .79-.5 1.96-.76 3.05-.22.91.46 1.65 1.36 1.65 1.63 0 2.89-1.72 2.89-4.2 0-2.2-1.58-3.74-3.84-3.74-2.62 0-4.16 1.96-4.16 3.99 0 .79.3 1.64.68 2.1.08.1.09.19.07.3l-.25 1.02c-.04.16-.13.19-.29.11-1.08-.5-1.75-2.08-1.75-3.35 0-2.73 1.98-5.23 5.7-5.23 2.99 0 5.32 2.13 5.32 4.98 0 2.97-1.87 5.36-4.46 5.36-.87 0-1.69-.45-1.97-.98l-.54 2.04c-.2.75-.75 1.69-1.12 2.26.84.26 1.73.4 2.65.4A9.5 9.5 0 1 0 12 2.5Z"/></svg>
        </a>
        <a class="social-icon-link" href="https://www.tripadvisor.com/Attraction_Review-g297713-d23850676-Reviews-Ola_Store_Solo-Solo_Central_Java_Java.html" target="_blank" rel="noopener noreferrer" aria-label="Tripadvisor">
          <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 5.2c-3.7 0-6.9 1.2-8.7 3.2H1.5v1.7h1.2c-.3.7-.5 1.5-.5 2.3a5.3 5.3 0 0 0 9.8 2.8 5.3 5.3 0 0 0 9.8-2.8c0-.8-.2-1.6-.5-2.3h1.2V8.4h-1.8C19 6.4 15.7 5.2 12 5.2Zm-5.2 3.4a3.8 3.8 0 1 1 0 7.6 3.8 3.8 0 0 1 0-7.6Zm10.4 0a3.8 3.8 0 1 1 0 7.6 3.8 3.8 0 0 1 0-7.6ZM6.8 11a1.4 1.4 0 1 0 0 2.8 1.4 1.4 0 0 0 0-2.8Zm10.4 0a1.4 1.4 0 1 0 0 2.8 1.4 1.4 0 0 0-2.8 0Z"/></svg>
        </a>
      </div>
    </div>
    <div class="footer-col">
      <h4>{t.footer.contact}</h4>
      <a class="footer-link" href={`https://wa.me/${site.waNumber}`} target="_blank" rel="noopener noreferrer">
        <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M20 11.5a8 8 0 0 1-11.8 7.1L4 20l1.4-4.1A8 8 0 1 1 20 11.5Z"/><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M9 8.5c.2 2 2.4 4.2 4.5 4.5l1.2-1.2c.2-.2.5-.3.8-.1l1.4.7c.3.1.4.4.3.7-.3 1.1-1.3 1.7-2.4 1.5-3.8-.7-6.8-3.7-7.5-7.5-.2-1.1.4-2.1 1.5-2.4.3-.1.6 0 .7.3l.7 1.4c.1.3.1.6-.1.8L9 8.5Z"/></svg>
        <span>WhatsApp</span>
      </a>
      <a class="footer-link" href={`mailto:${site.email}`}>
        <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path fill="none" stroke="currentColor" stroke-width="2" d="m4 7 8 6 8-6"/></svg>
        <span>Email</span>
      </a>
      <a class="footer-link" href={site.googleMapsUrl} target="_blank" rel="noopener noreferrer">
        <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5" fill="none" stroke="currentColor" stroke-width="2"/></svg>
        <span>Google Maps</span>
      </a>
    </div>
  </div>
  <div class="footer-bottom">
    © {new Date().getFullYear()} {site.siteName} — {site.location}. {t.footer.made}
  </div>
</footer>
<CookieConsent />
<style>
  .footer-brand-heading { display:flex; align-items:center; gap:.7rem; }
  .footer-brand-heading img { width:54px; height:54px; border-radius:10px; object-fit:cover; background:#fff; }
  .footer-link { display:flex !important; align-items:center; gap:.55rem; }
  .footer-icon { width:1.15rem; height:1.15rem; flex:0 0 1.15rem; }
  .social-icons { display:flex; align-items:center; gap:1rem; margin-top:.75rem; }
  .social-icon-link { display:inline-flex; align-items:center; justify-content:center; width:2.25rem; height:2.25rem; color:inherit; border:1px solid currentColor; border-radius:50%; transition:transform .2s ease, opacity .2s ease; }
  .social-icon-link:hover { transform:translateY(-2px); opacity:.8; }
  .social-icon-link .footer-icon { width:1.2rem; height:1.2rem; }
  @media (max-width: 767px) { .social-icons { justify-content:center; } }
  @media (max-width: 767px) {
    .footer-brand-heading { justify-content:center; }
    .footer-link { justify-content:center; }
  }
</style>

---
import site from '../data/site.json';

const iconSize = 20;
---

<footer class="footer" id="kontak">
  <div class="footer-inner">
    <div class="footer-brand">
      <h3>✦ {site.siteName}</h3>
      <p>Toko lurik & busana Jawa asli dari Pasar Klewer Solo. Melestarikan warisan budaya melalui fashion berkualitas.</p>
    </div>
    <div class="footer-col">
      <h4>Menu</h4>
      <a href="#home">Beranda</a>
      <a href="#produk">Katalog</a>
      <a href="#tentang">Tentang</a>
      <a href="#lokasi">Lokasi</a>
    </div>
    <div class="footer-col">
      <h4>Sosial Media</h4>
      <a class="footer-social-link" href={`https://instagram.com/${site.instagram.replace('@','')}`} target="_blank" rel="noopener noreferrer" aria-label={`Instagram ${site.instagram}`}>
        <svg class="footer-icon" width={iconSize} height={iconSize} viewBox="0 0 24 24" aria-hidden="true" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="2"/>
          <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="2"/>
          <circle cx="17.5" cy="6.7" r="1.15" fill="currentColor"/>
        </svg>
        <span>Instagram {site.instagram}</span>
      </a>
      <a class="footer-social-link" href={`https://facebook.com/${site.facebook}`} target="_blank" rel="noopener noreferrer" aria-label="Facebook Ola Store Solo">
        <svg class="footer-icon" width={iconSize} height={iconSize} viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
          <path d="M14 8h3V4.5c-.52-.08-1.68-.2-3.17-.2-3.13 0-5.28 1.91-5.28 5.42V13H5v3.9h3.55V24H12.8v-7.1h3.65L17 13H12.8V10.1c0-1.12.3-2.1 1.2-2.1Z" fill="currentColor"/>
        </svg>
        <span>Facebook</span>
      </a>
      <a class="footer-social-link" href={`https://x.com/${site.twitter}`} target="_blank" rel="noopener noreferrer" aria-label="X Ola Store Solo">
        <svg class="footer-icon" width={iconSize} height={iconSize} viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
          <path d="M18.244 2H21.5l-7.11 8.13L22.75 22h-6.58l-5.15-6.73L5.13 22H1.87l7.6-8.69L1.5 2h6.75l4.66 6.16L18.244 2Zm-1.15 17.87h1.8L7.23 4.02H5.3L17.094 19.87Z" fill="currentColor"/>
        </svg>
        <span>X / Twitter</span>
      </a>
    </div>
    <div class="footer-col">
      <h4>Kontak</h4>
      <a class="footer-social-link" href={`https://wa.me/${site.waNumber}`} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp Ola Store Solo">
        <svg class="footer-icon" width={iconSize} height={iconSize} viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
          <path d="M20.52 3.48A11.87 11.87 0 0 0 12.05 0C5.5 0 .17 5.33.17 11.9c0 2.1.55 4.15 1.6 5.96L.06 24l6.29-1.65a11.9 11.9 0 0 0 5.7 1.45h.01c6.55 0 11.88-5.34 11.88-11.9 0-3.18-1.23-6.17-3.42-8.42ZM12.06 21.8h-.01a9.9 9.9 0 0 1-5.05-1.38l-.36-.21-3.73.98 1-3.64-.23-.37a9.88 9.88 0 0 1-1.52-5.28c0-5.46 4.44-9.9 9.9-9.9 2.64 0 5.13 1.03 7 2.9a9.84 9.84 0 0 1 2.9 7c0 5.46-4.44 9.9-9.9 9.9Zm5.43-7.42c-.3-.15-1.77-.87-2.05-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.21 5.09 4.5.71.31 1.27.5 1.7.64.71.23 1.36.2 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z" fill="currentColor"/>
        </svg>
        <span>WhatsApp</span>
      </a>
      <a class="footer-social-link" href={`mailto:${site.email}`} aria-label={`Email ${site.email}`}>
        <svg class="footer-icon" width={iconSize} height={iconSize} viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
          <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" stroke="currentColor" stroke-width="2"/>
          <path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>Email</span>
      </a>
      <a class="footer-social-link" href={site.googleMapsUrl} target="_blank" rel="noopener noreferrer" aria-label="Google Maps Ola Store Solo">
        <svg class="footer-icon" width={iconSize} height={iconSize} viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 22s7-6.16 7-13A7 7 0 1 0 5 9c0 6.84 7 13 7 13Z" fill="currentColor"/>
          <circle cx="12" cy="9" r="2.5" fill="var(--cream)"/>
        </svg>
        <span>Google Maps</span>
      </a>
    </div>
  </div>
  <div class="footer-bottom">
    © {new Date().getFullYear()} {site.siteName} — {site.location}. Dibuat dengan ❤️ di Solo.
  </div>
</footer>
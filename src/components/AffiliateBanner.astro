---
interface Props {
  href?: string;
  image?: string;
  alt?: string;
}

const {
  href = 'https://invl.me/clnwq4v',
  image = 'https://img.involve.asia/rpss/campaigns_banners/83988-WfraMOvlzDCJrGJkELl3TBv5SvJeGRr5.png',
  alt = 'ID - Weekend Deals',
} = Astro.props;
---

<section class="affiliate-banner" aria-label="Rekomendasi">
  <div class="affiliate-banner-inner">
    <span class="affiliate-label">Rekomendasi</span>
    <a
      href={href}
      target="_blank"
      rel="nofollow sponsored noopener"
      aria-label="Lihat rekomendasi"
    >
      <img src={image} alt={alt} loading="lazy" decoding="async" />
    </a>
  </div>
</section>

<style>
  .affiliate-banner {
    padding: 1.5rem 1rem;
  }

  .affiliate-banner-inner {
    width: min(100%, 1000px);
    margin: 0 auto;
    text-align: center;
  }

  .affiliate-label {
    display: block;
    margin-bottom: 0.75rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .affiliate-banner a {
    display: block;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto;
    line-height: 0;
  }

  .affiliate-banner img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    border-radius: 10px;
  }

  .affiliate-banner a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 10px;
  }
</style>

---
import site from '../data/site.json';
import { getTranslations, type Language } from '../data/i18n';
const { lang = 'id' } = Astro.props as { lang?: Language };
const t = getTranslations(lang);
---

<section class="about" id="tentang">
  <div class="about-inner">
    <div class="about-img">
      <!-- GANTI FOTO: taruh gambar di public/images/about.webp -->
      <img src="/images/about.webp" alt="Tentang Ola Store" onerror="this.style.display='none'; this.parentElement.innerHTML='<span style=font-size:4rem;>🏪</span>';" />
    </div>
    <div class="about-content">
      <h2>{t.about.title}</h2>
      <p>{site.siteName} {t.about.p1} {site.location} {t.about.p2} {site.established}, {t.about.p3}</p>
      <p>{t.about.p4}</p>
      <div class="about-tags">
        <span class="about-tag">🧵 {t.about.handmade}</span>
        <span class="about-tag">🇮🇩 {t.about.local}</span>
        <span class="about-tag">♻️ {t.about.sustainable}</span>
        <span class="about-tag">⭐ {t.about.quality}</span>
      </div>
    </div>
  </div>
</section>
